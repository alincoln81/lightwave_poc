# Firebase Configuration (project identifiers — not authorization)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# App mode: test | live
# test locks this process to TEST_TOKEN / TEST_FIRESTORE_ROOT only.
# live loads every deployment from Firebase (use this on Render / production).
APP_MODE=live
TEST_TOKEN=lwtest_k8m2n4p6q
TEST_FIRESTORE_ROOT=lwLocalTest
TEST_DISPLAY_NAME=Lightwave Local Test

# Debug Mode
DEBUG_MODE_ENABLED=false

# Log Frequency
LOCAL_STATS_INTERVAL=20000
